{
  "name": "claude-multitask",
  "version": "1.0.0",
  "description": "Grid of terminals, each running Claude Code on an independent task (Windows, macOS, Linux)",
  "main": "dist/main/index.js",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "dev": "node scripts/build.mjs --watch",
    "rebuild": "electron-rebuild -f -w node-pty",
    "typecheck": "tsc --noEmit",
    "test": "esbuild scripts/test.ts --bundle --platform=node --format=cjs --external:node-pty --external:electron --outfile=dist/test.cjs --log-level=error && node --test --test-concurrency=1 dist/test.cjs",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "smoke": "esbuild scripts/smoke.ts --bundle --platform=node --format=cjs --external:node-pty --external:electron --outfile=dist/smoke.cjs",
    "check:themes": "esbuild scripts/check-themes.ts --bundle --platform=node --format=cjs --outfile=dist/check-themes.cjs --log-level=error && node dist/check-themes.cjs"
  },
  "dependencies": {
    "node-pty": "^1.0.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.6.0",
    "@types/node": "^22.7.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.15.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "electron": "^32.2.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0",
    "zod": "^3.23.8"
  }
}
